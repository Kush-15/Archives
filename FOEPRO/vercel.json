{
  "version": 2,
  "buildCommand": "bash build.sh",
  "outputDirectory": ".vercel/output",
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.py" },
    { "src": "/static/(.*)", "dest": "api/index.py" },
    { "src": "/media/(.*)", "dest": "api/index.py" },
    { "src": "/(.*)", "dest": "api/index.py" }
  ]
}
